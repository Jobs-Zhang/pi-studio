{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pi-studio-docs-dev",
  "compatibility_date": "2026-05-20",
  "observability": {
    "enabled": true
  },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "pi-studio.dev/dev/*",
      "zone_name": "pi-studio.dev"
    }
  ],
  "assets": {
    "directory": "./.deploy/dev",
    "not_found_handling": "404-page"
  }
}
