{
  "name": "@pi-studio/pi-studio",
  "version": "1.202610.1",
  "description": "PI STUDIO: a lightweight, multi-platform coding workspace for Pi Coding Agent, with Web, Windows Desktop, and Android clients.",
  "license": "MIT",
  "author": {
    "name": "Jobs Zhang",
    "url": "https://github.com/Jobs-Zhang"
  },
  "contributors": [
    {
      "name": "Federico Jaramillo Martinez",
      "url": "https://github.com/jmfederico"
    }
  ],
  "type": "module",
  "exports": {
    "./plugin-api": {
      "types": "./dist/plugin-api.d.ts"
    },
    "./server-plugin-api": {
      "types": "./dist/server-plugin-api.d.ts",
      "import": "./dist/server-plugin-api.js"
    }
  },
  "typesVersions": {
    "*": {
      "plugin-api": [
        "dist/plugin-api.d.ts"
      ],
      "server-plugin-api": [
        "dist/server-plugin-api.d.ts"
      ]
    }
  },
  "bin": {
    "pi-studio": "dist/cli.js",
    "pi-studio-server": "dist/server/index.js",
    "pi-studio-sessiond": "dist/server/sessiond.js"
  },
  "files": [
    "dist",
    "install.sh",
    "README.md",
    "LICENSE",
    "extensions",
    "examples/workspace-provider-plugin",
    "examples/session-bridge-plugin",
    "!examples/**/node_modules",
    "!examples/**/dist",
    "docs/plugins.md",
    "docs/config.md",
    "docs/assets",
    "plugin-api.d.ts",
    "server-plugin-api.d.ts"
  ],
  "scripts": {
    "dev": "bash -c 'trap \"kill 0\" EXIT; npm run dev:sessiond & npm run dev:web & npm run dev:client & wait'",
    "dev:sessiond": "node scripts/dev-sessiond.mjs --watch",
    "dev:web": "tsc -p tsconfig.plugins.json && node scripts/dev-web.mjs",
    "dev:server": "npm run dev:web",
    "dev:client": "vite --host 0.0.0.0",
    "dev:plugins": "node scripts/build-plugins.mjs --watch",
    "build": "npm run clean && tsc -p tsconfig.build.json && npm run build:plugin-api && npm run build:plugins && vite build",
    "build:plugin-api": "tsc -p tsconfig.plugin-api.json",
    "build:plugins": "tsc -p tsconfig.plugins.json && node scripts/build-plugins.mjs",
    "capture:screenshots": "node scripts/capture-screenshots.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:cached": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/pi-studio/typecheck.tsbuildinfo",
    "knip": "knip",
    "lint": "eslint \"src/**/*.ts\" \"extensions/**/*.ts\" \"pi-studio-plugins/**/*.ts\" \"pi-packages/**/*.ts\" vite.config.ts vitest.artifacts.config.ts",
    "check:artifacts": "vitest run --config vitest.artifacts.config.ts",
    "verify": "npm run typecheck && npm run lint && npm run knip",
    "verify:staged": "node scripts/verify-staged.mjs",
    "start": "tsx src/server/index.ts",
    "start:sessiond": "node scripts/dev-sessiond.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "npm run build",
    "pack:dry": "npm pack --dry-run",
    "smoke:package-install": "node scripts/smoke-package-install.mjs",
    "prepublishOnly": "npm run verify",
    "publish:npm": "npm publish --access public",
    "prepare": "node scripts/install-git-hooks.mjs",
    "changeset": "changeset",
    "release:version": "changeset version",
    "changelog:status": "changeset status"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@fastify/compress": "^9.0.0",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "fastify": "^5.10.0",
    "lit": "^3.3.3",
    "marked": "^18.0.6",
    "node-pty": "^1.1.0",
    "pi-studio-typebox": "npm:typebox@1.3.7",
    "undici": "^8.5.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@earendil-works/pi-agent-core": "^1.0.0",
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "dompurify": "^3.4.15",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "happy-dom": "^21.0.3",
    "knip": "^6.25.0",
    "mermaid": "^11.17.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jobs-Zhang/pi-studio.git"
  },
  "bugs": {
    "url": "https://github.com/Jobs-Zhang/pi-studio/issues"
  },
  "homepage": "https://pi-studio.dev/",
  "packageManager": "npm@11.11.0",
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "^1.0.0",
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-studio",
    "pi-studio-ui",
    "pi-studioui",
    "pi-coding-agent",
    "pi-coding-agent-web-ui",
    "coding-agent",
    "ai-coding-agent",
    "agentic-development",
    "developer-tools",
    "web-ui",
    "webui",
    "browser-ui",
    "remote-development",
    "persistent-sessions"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "image": "https://raw.githubusercontent.com/Jobs-Zhang/pi-studio/main/docs/assets/pi-studio-banner.png"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "electron@38.8.6": true,
    "electron-builder@26.0.0": true
  }
}
