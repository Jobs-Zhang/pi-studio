{
  "name": "@jmfederico/pi-captains-log",
  "version": "0.1.0",
  "description": "Opt-in Captain's Log: translate the selected session's last reply into pirate through a native Pi companion and PI STUDIO panel",
  "private": true,
  "type": "module",
  "keywords": ["pi-package"],
  "files": ["dist", "src", "docs", "tsconfig.json", "vite.config.mjs"],
  "scripts": { "build": "tsc -p tsconfig.json && vite build" },
  "dependencies": {
    "marked": "^18.0.6"
  },
  "devDependencies": {
    "@pi-studio/pi-studio": "^1.202609.1",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@pi-studio/pi-studio": "^1.202609.1"
  },
  "pi": { "extensions": ["./dist/companion.js"] },
  "piStudio": {
    "plugins": [{
      "id": "captains-log",
      "defaultEnabled": false,
      "browserRoot": "dist/browser",
      "module": "dist/browser/index.js",
      "serverModule": "dist/server.js",
      "machineSpecific": true
    }]
  }
}
