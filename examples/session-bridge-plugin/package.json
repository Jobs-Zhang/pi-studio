{
  "name": "pi-studio-example-workspace-reviews",
  "description": "Opt-in PI STUDIO workspace reviews with a native Pi companion and saved findings",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "keywords": ["pi-package"],
  "scripts": { "build": "tsc -p tsconfig.json" },
  "devDependencies": {
    "@pi-studio/pi-studio": "^1.202609.1",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "^1.0.0" },
  "pi": { "extensions": ["./src/companion.ts"] },
  "piStudio": {
    "plugins": [{
      "id": "workspace-reviews-example",
      "browserRoot": "dist/browser",
      "module": "dist/browser/index.js",
      "serverModule": "dist/server.js",
      "machineSpecific": true
    }]
  }
}
