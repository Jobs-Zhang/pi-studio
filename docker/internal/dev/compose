#!/usr/bin/env sh
set -eu

log() {
  printf '%s\n' "$*" >&2
}

die() {
  log "pi-studio Docker dev compose: $*"
  exit 1
}

script_dir=$(unset CDPATH; cd "$(dirname "$0")" && pwd -P)
repo_root=$(unset CDPATH; cd "$script_dir/../../.." && pwd -P)
dev_config_file=$repo_root/.pi-studio/docker-compose-dev.local.env
legacy_dev_env_file=$repo_root/.pi-studio/docker-compose-dev.env
generated_env_file=$repo_root/.pi-studio/docker-compose-dev.generated.env

# shellcheck source=../host-profile.sh
# shellcheck disable=SC1091
. "$repo_root/docker/internal/host-profile.sh"

strip_wrapping_quotes() {
  value=$1
  case "$value" in
    \"*\")
      case "$value" in
        *\") value=${value#\"}; value=${value%\"} ;;
      esac
      ;;
    \'*\')
      case "$value" in
        *\') value=${value#\'}; value=${value%\'} ;;
      esac
      ;;
  esac
  printf '%s\n' "$value"
}

env_file_value() {
  file=$1
  key=$2
  [ -f "$file" ] || return 1
  raw=$(awk -v key="$key" '
    function trim(value) {
      sub(/^[ \t]+/, "", value)
      sub(/[ \t\r]+$/, "", value)
      return value
    }
    /^[ \t]*(#|$)/ { next }
    {
      line = $0
      sub(/^[ \t]*export[ \t]+/, "", line)
      name = line
      sub(/=.*/, "", name)
      name = trim(name)
      if (name == key) {
        sub(/^[^=]*=/, "", line)
        print trim(line)
        found = 1
        exit
      }
    }
    END { if (!found) exit 1 }
  ' "$file") || return 1
  strip_wrapping_quotes "$raw"
}

dev_config_value() {
  env_file_value "$dev_config_file" "$1"
}

runtime_env_value() {
  env_file_value "$runtime_env_file" "$1"
}

generated_env_value() {
  env_file_value "$generated_env_file" "$1"
}

write_initial_dev_config() {
  [ ! -e "$dev_config_file" ] || return 0

  temp_config=$dev_config_file.$$
  previous_umask=$(umask)
  umask 077
  cat >"$temp_config" <<'EOF'
# PI STUDIO Docker dev settings. Safe to edit.
#
# docker/pi-studio-docker --dev creates this file once and does not
# overwrite it. Put persistent dev Docker settings here.
#
# Precedence for values used by docker/pi-studio-docker --dev:
#   1. this file
#   2. previous generated values, when present
#   3. current shell environment, on first generation only
#   4. runtime installer env, usually ~/.local/share/pi-studio-docker/.env
#   5. built-in defaults
#
# Generated effective values are written to:
#   .pi-studio/docker-compose-dev.generated.env
#
# Bind addresses:
# - 127.0.0.1 exposes only to this machine.
# - 0.0.0.0 exposes on all host interfaces. Use only on trusted networks.
#
# Uncomment or add values to persist them. PI_STUDIO_DEV_API_BIND_ADDR
# controls the web/API server; PI_STUDIO_DEV_BIND_ADDR controls the Vite UI.
# PI_STUDIO_DEV_API_BIND_ADDR=127.0.0.1
# PI_STUDIO_DEV_BIND_ADDR=127.0.0.1
# PI_STUDIO_DEV_API_PORT=8504
# PI_STUDIO_DEV_PORT=8505
#
# PI_STUDIO_DEV_SESSIOND_SOCKET defaults to /data/pi-studio/sessiond-dev.sock so the
# dev session daemon does not collide with a runtime stack sharing the same
# data directory. Override only if you intentionally want a different path.
# PI_STUDIO_DEV_SESSIOND_SOCKET=/data/pi-studio/sessiond-dev.sock
#
# Shared Docker/runtime-style defaults may also be set here:
# PI_STUDIO_DOCKER_DATA_DIR=/absolute/path/to/pi-studio-docker/data
# PI_STUDIO_DOCKER_EXTRA_HOST_PATHS="/absolute/path/one /absolute/path/two"
#
# PI_STUDIO_UID and PI_STUDIO_GID default to the current host user so
# bind-mounted checkout files are not written as root or another user.
# Set them here only if you intentionally want a different container user.
EOF
  umask "$previous_umask"

  if [ -f "$legacy_dev_env_file" ]; then
    {
      printf '\n%s\n' "# Values copied from the previous generated dev env file."
      printf '%s\n' "# Keep, edit, or delete these lines as needed."
      for key in PI_STUDIO_DEV_API_BIND_ADDR PI_STUDIO_DEV_BIND_ADDR PI_STUDIO_DEV_API_PORT PI_STUDIO_DEV_PORT; do
        if value=$(env_file_value "$legacy_dev_env_file" "$key"); then
          printf '%s=%s\n' "$key" "$value"
        fi
      done
    } >>"$temp_config"
  fi

  mv "$temp_config" "$dev_config_file"
  log "Created user-editable dev config: $dev_config_file"
}

value_from_config_or_generated_or_env_or_runtime_or_default() {
  key=$1
  default_value=$2
  if existing=$(dev_config_value "$key"); then
    printf '%s\n' "$existing"
  elif existing=$(generated_env_value "$key"); then
    printf '%s\n' "$existing"
  else
    eval "is_set=\${$key+x}"
    if [ "${is_set:-}" = x ]; then
      eval "printf '%s\n' \"\${$key}\""
    elif existing=$(runtime_env_value "$key"); then
      printf '%s\n' "$existing"
    else
      printf '%s\n' "$default_value"
    fi
  fi
}

value_from_config_or_generated_or_env_or_default() {
  key=$1
  default_value=$2
  if existing=$(dev_config_value "$key"); then
    printf '%s\n' "$existing"
  elif existing=$(generated_env_value "$key"); then
    printf '%s\n' "$existing"
  else
    eval "is_set=\${$key+x}"
    if [ "${is_set:-}" = x ]; then
      eval "printf '%s\n' \"\${$key}\""
    else
      printf '%s\n' "$default_value"
    fi
  fi
}

is_truthy() {
  case "${1:-}" in
    ""|0|false|FALSE|False) return 1 ;;
    *) return 0 ;;
  esac
}

is_unsigned_int() {
  case "${1:-}" in
    ""|*[!0-9]*) return 1 ;;
    *) return 0 ;;
  esac
}

require_unsigned_int() {
  name=$1
  value=$2
  is_unsigned_int "$value" || die "$name must be a numeric Unix id, got: $value"
}

enforce_dev_root_safety() {
  uid=$(id -u 2>/dev/null || printf '0')
  [ "$uid" != 0 ] || is_truthy "${PI_STUDIO_DOCKER_ALLOW_ROOT:-0}" || die "refusing to run Docker development mode as root; retry with --allow-root if this is intentional"
}

enforce_non_root_dev_uid() {
  [ "${1:-0}" -ne 0 ] || is_truthy "${PI_STUDIO_DOCKER_ALLOW_ROOT:-0}" || die "refusing to generate Docker development env with PI_STUDIO_UID=0; retry with --allow-root if this is intentional"
}

enforce_dev_root_safety

# Dev Compose commands also run inside detached helper containers, which cannot
# observe the Docker host. Reuse the host facts recorded on the last host run.
if ! pi_studio_docker_host_resolve_profile \
  "$(generated_env_value PI_STUDIO_DOCKER_HOST_PROFILE 2>/dev/null || true)" \
  "$(generated_env_value HOSTEXEC_MODE 2>/dev/null || true)" \
  "$(generated_env_value PI_STUDIO_DOCKER_SOCKET_SOURCE 2>/dev/null || true)"; then
  pi_studio_docker_host_print_detection_failure
  die "refusing to run Docker Compose for an unsupported or unknown host setup"
fi

runtime_env_file=${PI_STUDIO_DOCKER_RUNTIME_ENV_FILE:-}
if [ -z "$runtime_env_file" ] && [ -n "${HOME:-}" ]; then
  runtime_env_file=$HOME/.local/share/pi-studio-docker/.env
fi

mkdir -p "$repo_root/.pi-studio" || die "could not create .pi-studio directory"
write_initial_dev_config

host_uid=$(id -u 2>/dev/null || printf '0')
host_gid=$(id -g 2>/dev/null || printf '0')
pi_studio_uid=$(value_from_config_or_generated_or_env_or_default PI_STUDIO_UID "$host_uid")
pi_studio_gid=$(value_from_config_or_generated_or_env_or_default PI_STUDIO_GID "$host_gid")
docker_gid=$(value_from_config_or_generated_or_env_or_runtime_or_default DOCKER_GID "$(pi_studio_docker_host_detect_docker_gid)")
default_data_dir=${HOME:-$repo_root/.pi-studio}/.local/share/pi-studio-docker/data
pi_studio_data_dir=$(value_from_config_or_generated_or_env_or_runtime_or_default PI_STUDIO_DOCKER_DATA_DIR "$default_data_dir")
pi_studio_extra_host_paths=$(value_from_config_or_generated_or_env_or_runtime_or_default PI_STUDIO_DOCKER_EXTRA_HOST_PATHS "")
pi_studio_opensuse_image=$(value_from_config_or_generated_or_env_or_runtime_or_default PI_STUDIO_OPENSUSE_IMAGE opensuse/tumbleweed)
pi_studio_nodejs_major=$(value_from_config_or_generated_or_env_or_runtime_or_default PI_STUDIO_NODEJS_MAJOR 22)
pi_studio_nodejs_repo=$(value_from_config_or_generated_or_env_or_runtime_or_default PI_STUDIO_NODEJS_REPO auto)
pi_studio_extra_zypper_packages=$(value_from_config_or_generated_or_env_or_runtime_or_default PI_STUDIO_EXTRA_ZYPPER_PACKAGES "")
pi_studio_dev_image=$(value_from_config_or_generated_or_env_or_runtime_or_default PI_STUDIO_DEV_IMAGE pi-studio:dev)
compose_project_name=$(value_from_config_or_generated_or_env_or_default COMPOSE_PROJECT_NAME pi-studio-dev)
hostexec_image=$(value_from_config_or_generated_or_env_or_runtime_or_default HOSTEXEC_IMAGE alpine:3.22)
pi_studio_max_upload_bytes=$(value_from_config_or_generated_or_env_or_runtime_or_default PI_STUDIO_MAX_UPLOAD_BYTES 67108864)
default_dev_bind_addr=$(value_from_config_or_generated_or_env_or_runtime_or_default PI_STUDIO_BIND_ADDR 127.0.0.1)
pi_studio_dev_api_bind_addr=$(value_from_config_or_generated_or_env_or_runtime_or_default PI_STUDIO_DEV_API_BIND_ADDR "$default_dev_bind_addr")
pi_studio_dev_bind_addr=$(value_from_config_or_generated_or_env_or_runtime_or_default PI_STUDIO_DEV_BIND_ADDR "$default_dev_bind_addr")
pi_studio_dev_api_port=$(value_from_config_or_generated_or_env_or_runtime_or_default PI_STUDIO_DEV_API_PORT 8504)
pi_studio_dev_port=$(value_from_config_or_generated_or_env_or_runtime_or_default PI_STUDIO_DEV_PORT 8505)
pi_studio_dev_sessiond_socket=$(value_from_config_or_generated_or_env_or_default PI_STUDIO_DEV_SESSIOND_SOCKET /data/pi-studio/sessiond-dev.sock)

require_unsigned_int PI_STUDIO_UID "$pi_studio_uid"
require_unsigned_int PI_STUDIO_GID "$pi_studio_gid"
require_unsigned_int DOCKER_GID "$docker_gid"
enforce_non_root_dev_uid "$pi_studio_uid"
case "$pi_studio_data_dir" in
  /*) ;;
  *) die "PI_STUDIO_DOCKER_DATA_DIR must be an absolute path, got: $pi_studio_data_dir" ;;
esac
[ -n "$compose_project_name" ] || die "COMPOSE_PROJECT_NAME must not be empty"

mkdir -p "$pi_studio_data_dir" || die "could not create data directory: $pi_studio_data_dir"

container_env_file=$pi_studio_data_dir/container.env
if ! pi_studio_docker_write_container_env_template "$container_env_file"; then
  die "could not create container environment file: $container_env_file"
fi

dev_container_env_file=$repo_root/.pi-studio/docker-compose-dev.container.env
if [ ! -e "$dev_container_env_file" ]; then
  (
    umask 077
    cat >"$dev_container_env_file" <<'EOF'
# PI STUDIO development-only container environment. Safe to edit.
# Loaded after shared container.env for dev web and sessiond only.
# This file is gitignored and never rewritten. Docker Compose dotenv rules apply.
# Explicit Compose environment values still take precedence.
#
# Apply with pi-studio-docker --dev start (recreates changed containers).
# Recreating sessiond interrupts active dev sessions; restart does not reload env files.
#
# Example: keep dev remote machines separate from production.
# PI_STUDIO_MACHINES_FILE=/data/pi-studio/machines-dev.json
EOF
  ) || die "could not create dev container environment file: $dev_container_env_file"
fi

env_file=$generated_env_file
override_file=$repo_root/.pi-studio/docker-compose-dev.host.generated.yml

if ! pi_studio_docker_host_write_compose_override "$override_file" "$PI_STUDIO_DETECTED_DOCKER_HOST_PROFILE" "$pi_studio_extra_host_paths"; then
  die "could not write host-specific Compose override"
fi

umask 077
temp_env=$env_file.$$
cat >"$temp_env" <<EOF
# Generated by docker/pi-studio-docker --dev. Do not edit by hand.
PI_STUDIO_UID=$pi_studio_uid
PI_STUDIO_GID=$pi_studio_gid
DOCKER_GID=$docker_gid
PI_STUDIO_DOCKER_DATA_DIR=$pi_studio_data_dir
PI_STUDIO_DOCKER_DEV_REPO_ROOT=$repo_root
PI_STUDIO_DOCKER_HOST_PROFILE=$PI_STUDIO_DETECTED_DOCKER_HOST_PROFILE
PI_STUDIO_DOCKER_SOCKET_SOURCE=$PI_STUDIO_DETECTED_DOCKER_SOCKET_SOURCE
HOSTEXEC_MODE=$PI_STUDIO_DETECTED_HOSTEXEC_MODE
PI_STUDIO_DOCKER_EXTRA_HOST_PATHS=$pi_studio_extra_host_paths
PI_STUDIO_OPENSUSE_IMAGE=$pi_studio_opensuse_image
PI_STUDIO_NODEJS_MAJOR=$pi_studio_nodejs_major
PI_STUDIO_NODEJS_REPO=$pi_studio_nodejs_repo
PI_STUDIO_EXTRA_ZYPPER_PACKAGES=$pi_studio_extra_zypper_packages
PI_STUDIO_DEV_IMAGE=$pi_studio_dev_image
COMPOSE_PROJECT_NAME=$compose_project_name
HOSTEXEC_IMAGE=$hostexec_image
PI_STUDIO_MAX_UPLOAD_BYTES=$pi_studio_max_upload_bytes
PI_STUDIO_DEV_API_BIND_ADDR=$pi_studio_dev_api_bind_addr
PI_STUDIO_DEV_BIND_ADDR=$pi_studio_dev_bind_addr
PI_STUDIO_DEV_API_PORT=$pi_studio_dev_api_port
PI_STUDIO_DEV_PORT=$pi_studio_dev_port
PI_STUDIO_DEV_SESSIOND_SOCKET=$pi_studio_dev_sessiond_socket
EOF
mv "$temp_env" "$env_file"

if [ "${PI_STUDIO_DOCKER_HOST_PROFILE_REUSED:-0}" = 1 ]; then
  log "Reused the recorded PI STUDIO Docker host profile: $PI_STUDIO_DETECTED_DOCKER_HOST_PROFILE"
else
  log "Selected PI STUDIO Docker host profile: $PI_STUDIO_DETECTED_DOCKER_HOST_PROFILE"
fi
if [ -f "$runtime_env_file" ]; then
  log "Reused runtime Docker environment defaults from: $runtime_env_file"
fi
case "$PI_STUDIO_DETECTED_DOCKER_HOST_PROFILE" in
  linux-native-docker)
    log "Enabled Linux host mounts and hostexec namespace bridge."
    ;;
  mac-docker-desktop)
    log "Enabled Docker Desktop for Mac project mounts. hostexec is disabled because containers cannot enter native macOS namespaces."
    ;;
esac
log "User-editable dev config: $dev_config_file"
log "Container environment (shared with runtime mode): $container_env_file"
log "Dev container environment (safe to edit): $dev_container_env_file"
log "Generated dev env: $env_file"
log "Generated dev Compose override: $override_file"

if [ "$#" -eq 0 ]; then
  set -- up --build
fi

pi_studio_docker_compose \
  --project-name "$compose_project_name" \
  --env-file "$env_file" \
  -f "$repo_root/docker/compose.dev.yml" \
  -f "$override_file" \
  "$@"
