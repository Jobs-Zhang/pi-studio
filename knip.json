{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/cli.ts",
    "src/plugin-api.ts",
    "src/server-plugin-api.ts",
    "src/client/src/api.ts",
    "src/shared/apiTypes.ts",
    "src/server/types.ts",
    "src/server/sessiond.ts",
    "src/server/piStudioPluginService.ts",
    "extensions/pi-studio.ts",
    "pi-studio-plugins/**/pi-studio-plugin.ts",
    "pi-studio-plugins/**/server-plugin.ts",
    "pi-packages/**/pi-studio-plugin.ts",
    "pi-packages/captains-log/src/browser/index.ts",
    "pi-packages/captains-log/src/server.ts",
    "pi-packages/captains-log/src/companion.ts",
    "scripts/*.mjs"
  ],
  "project": [
    "src/**/*.ts",
    "extensions/**/*.ts",
    "pi-studio-plugins/**/*.ts",
    "pi-packages/**/*.ts"
  ],
  "ignoreExportsUsedInFile": true
}
