{
  "name": "pi-studio-desktop",
  "version": "0.1.0",
  "private": true,
  "author": {
    "name": "Jobs Zhang",
    "url": "https://github.com/Jobs-Zhang"
  },
  "contributors": [
    {
      "name": "Federico Jaramillo Martinez",
      "url": "https://github.com/jmfederico"
    }
  ],
  "description": "Desktop client for PI STUDIO - Connect to your AI coding workspace",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "start:dev": "electron . --url=http://127.0.0.1:8505",
    "start:local": "electron . --url=http://127.0.0.1:8504",
    "build": "electron-builder --win --config electron-builder.yml",
    "prebuild": "npm run build:icon",
    "build:icon": "node build-icon.js"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "electron-builder@26.0.0": true,
    "electron-winstaller@5.4.0": true
  }
}